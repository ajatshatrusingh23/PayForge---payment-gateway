# Everything has a working local default. Override for real deployments.
NODE_ENV=development
DEMO_MODE=true                  # enables chaos controls + on-demand settlement
LOG_JSON=false

# REQUIRED in production (services refuse to start with the dev defaults)
INTERNAL_TOKEN=change-me-long-random-string
JWT_SECRET=change-me-long-random-string
VAULT_MASTER_KEYS=1:<base64 32 bytes>   # openssl rand -base64 32
VAULT_FINGERPRINT_KEY=<base64 32 bytes>
BANK_CALLBACK_SECRET=change-me

# Infrastructure
DATABASE_HOST=localhost
DATABASE_PORT=55432
DATABASE_USER=payforge
DATABASE_PASSWORD=payforge
REDIS_URL=redis://localhost:6379
KAFKA_BROKERS=localhost:19092

# Tuning
ROUTING_STRATEGY=smart          # smart | single
ROUTING_EPSILON=0.05
ACQUIRER_TIMEOUT_MS=3000
RISK_TIMEOUT_MS=500
WEBHOOK_MAX_ATTEMPTS=8
WEBHOOK_BACKOFF_BASE_MS=5000
RATE_LIMIT_SECRET_RPS=100
OTEL_ENABLED=false
